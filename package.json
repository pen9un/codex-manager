{
  "name": "codex-manager",
  "version": "2.0.1",
  "description": "Codex 本地管理工作台，集中管理账号、提示词、扩展与主题",
  "author": "Codex-Manager 贡献者",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "pnpm run typecheck && electron-vite build",
    "build:win": "pnpm run build && electron-builder --win nsis --x64",
    "test": "vitest run --testTimeout=120000",
    "test:ci": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs run --testTimeout=120000 --maxWorkers=1 --no-file-parallelism",
    "test:memories": "vitest run tests/memory",
    "test:memories:ui": "pnpm build && electron tests/memory_ui.cjs",
    "test:sessions": "vitest run tests/session",
    "test:sessions:ui": "pnpm build && electron tests/session_ui.cjs",
    "test:sessions:perf": "pnpm build && electron --js-flags=\"--max-old-space-size=256\" tests/session_performance.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@iarna/toml": "^2.2.5",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  }
}
